mqtt:
  enabled: true
  host: "{{ mqtt_host }}"
  user: "{{ mqtt_user}}"
  password: "{{ mqtt_password }}"

ui:
  time_format: 24hour

detectors:
  coral:
    type: edgetpu
    device: pci

detect:
  enabled: true
  fps: 5

# model:
#   path: /config/mobilenet_v2/1.tflite
#   labelmap_path: /config/mobilenet_v2/imagenet_labels.txt
#   width: 224
#   height: 224

objects:
  track:
    - person
    - cat
    - bird
    - dog
    - car
    - bicycle
    - motorcycle

record:
  enabled: true
  retain:
    days: 28
    mode: all
  preview:
    # Optional: Quality of recording preview (default: medium).
    # Options are: very_low, low, medium, high, very_high
    quality: high
  alerts:
    pre_capture: 10
    post_capture: 10
  detections:
    pre_capture: 10
    post_capture: 10
snapshots:
  enabled: true
  bounding_box: true

go2rtc:
  streams:
    cam1:
      - rtsp://admin:{{ admin_password }}@192.168.1.101:554/live0.264
    cam2:
      - rtsp://admin:{{ admin_password }}@192.168.1.102:554/live0.265
    cam3:
      - rtsp://admin:{{ admin_password }}@192.168.1.103:554/live0.264
    cam4:
      - rtsp://admin:{{ admin_password }}@192.168.1.104:554/live0.264
    # cam5:
    #   - rtsp://admin:{{ admin_password }}@192.168.1.105:554/live0.264
    cam6:
      - rtsp://admin:{{ admin_password }}@192.168.1.106:554/live0.264
    cam7:
      - rtsp://admin:{{ admin_password_2 }}@192.168.1.107:554/stream1
  webrtc:
    candidates:
      - frigate:8555

# Optional: jsmpeg stream configuration for WebUI
# live:
#   height: 1080
#   quality: 1
# birdseye:
#   enabled: true
#   mode: continuous
#   width: 2560
#   height: 1440
#   quality: 1

cameras:
  cam1:
    enabled: true
    ffmpeg:
      hwaccel_args: preset-vaapi
      inputs:
        - path: rtsp://127.0.0.1:8554/cam1
          input_args: preset-rtsp-restream
          roles:
            - record
        - path: rtsp://admin:{{ admin_password }}@192.168.1.101:554/live1.264
          roles:
            - detect
    objects:
      track:
        - person
        - cat
        - dog
        - bird
    motion:
      mask: 0.75,0,1,0,1,0.048,0.75,0.046
  cam2:
