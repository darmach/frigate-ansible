        - path:
            rtsp://192.168.1.102:554/user=admin_password={{ admin_password }}_channel=1_stream=1&onvif=0.sdp?real_stream
          roles:
            - detect
    motion:
      mask: 0.75,0,1,0,1,0.048,0.75,0.046
      threshold: 30
      contour_area: 30
      improve_contrast: true
    zones:
      Street:
        coordinates: 0,0.623,1,0.35,1,0.258,0.474,0.317,0,0.442
        inertia: 3
      Sidewalk:
